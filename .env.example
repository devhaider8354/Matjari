# انسخ هذا الملف إلى .env.local وعدّل القيم

# رابط قاعدة البيانات MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/matjari

# مفتاح توقيع الجلسات: 32 حرفاً على الأقل
# لتوليده: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# مسار لوحة الإدارة السري: /admin يرجع 404 والإدارة تكون على https://موقعك/<ADMIN_PATH>
# اختر شيئاً صعب التخمين، مثل: node -e "console.log('cp-'+require('crypto').randomBytes(5).toString('hex'))"
ADMIN_PATH=
# المدير الافتراضي: يُنشأ تلقائياً عند أول دخول للوحة إذا لم يوجد أي مدير.
# بعد الدخول يُطلب تغيير كلمة المرور فوراً، ويمكن تغيير البريد من «حسابي والأمان».
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=
# (اختياري) السماح بدخول الإدارة من عناوين IP محددة فقط، مفصولة بفاصلة
ADMIN_ALLOWED_IPS=

# رابط الموقع (يُستخدم في روابط استعادة كلمة المرور والوصولات وخريطة الموقع)
APP_URL=http://localhost:3000

# البريد لإرسال روابط استعادة كلمة المرور.
# بدون SMTP_HOST تُطبع الروابط في سجل الخادم (مناسب للتجربة فقط)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="متجري <no-reply@example.com>"

# (اختياري) Redis لحدود المحاولات: تبقى بعد إعادة التشغيل وتعمل مع عدة نسخ من التطبيق
REDIS_URL=

# (اختياري) بوت تيليجرام لإشعارات الطلبات الجديدة (من @BotFather).
# الـ Chat ID يُضبط من اللوحة: التسويق والإشعارات
TELEGRAM_BOT_TOKEN=

# (اختياري) مفتاح Pexels المجاني لجلب صور منتجات احترافية: https://www.pexels.com/api/
# مطلوب لأمر npm run fetch-images
PEXELS_API_KEY=

# إعدادات المتجر (تُقرأ وقت البناء: أعد npm run build بعد تغييرها)
NEXT_PUBLIC_STORE_NAME=متجري
NEXT_PUBLIC_STORE_NAME_EN=Matjari
# العملة الأساسية: الأسعار تُدخل بها في لوحة التحكم (العملات الأخرى تضاف من اللوحة)
NEXT_PUBLIC_CURRENCY_CODE=USD
NEXT_PUBLIC_CURRENCY=$
NEXT_PUBLIC_CURRENCY_DECIMALS=2
NEXT_PUBLIC_SHIPPING_FEE=5
# الشحن مجاني إذا تجاوز المجموع هذا المبلغ (0 = لا يوجد شحن مجاني)
NEXT_PUBLIC_FREE_SHIPPING_OVER=100
# رقم واتساب المتجر بالصيغة الدولية بدون + (اختياري)
NEXT_PUBLIC_WHATSAPP=

# Shared demonstration account credentials stay fixed when enabled.
DEMO_MODE=false
